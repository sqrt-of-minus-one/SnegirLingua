<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tool="http://schemas.android.com/tools">
	
	<CheckBox
		android:id="@+id/a_dictionary_word_addedCB"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		app:layout_constraintLeft_toLeftOf="parent"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintBottom_toBottomOf="parent"/>
	
	<TextView
		android:id="@+id/a_dictionary_word_word1TV"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		app:layout_constraintBaseline_toBaselineOf="@id/a_dictionary_word_addedCB"
		app:layout_constraintLeft_toRightOf="@id/a_dictionary_word_addedCB"
		tool:text="word"/>
	
	<TextView
		android:id="@+id/a_dictionary_word_word2TV"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		app:layout_constraintBaseline_toBaselineOf="@id/a_dictionary_word_word1TV"
		app:layout_constraintRight_toRightOf="parent"
		android:layout_marginRight="5dp"
		tool:text="word"/>

</androidx.constraintlayout.widget.ConstraintLayout>