<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tool="http://schemas.android.com/tools">
	
	<ImageButton
		android:id="@+id/dictionary_colorIB"
		android:layout_width="50dp"
		android:layout_height="50dp"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintLeft_toLeftOf="parent"
		android:layout_margin="10dp"
		android:contentDescription="@string/a_dictionary_selectColor"/>
	
	<EditText
		android:id="@+id/dictionary_nameET"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		app:layout_constraintTop_toTopOf="@id/dictionary_colorIB"
		app:layout_constraintLeft_toRightOf="@id/dictionary_colorIB"
		app:layout_constraintRight_toLeftOf="@id/dictionary_sortRG"
		android:hint="@string/a_dictionary_name"
		android:autofillHints="dictionary"
		android:inputType="text"/>
	
	<androidx.constraintlayout.widget.Barrier
		android:id="@+id/dictionary_nameBR"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		app:barrierDirection="bottom"
		app:constraint_referenced_ids="dictionary_colorIB,dictionary_nameET"/>
	
	<EditText
		android:id="@+id/dictionary_descriptionET"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		app:layout_constraintTop_toBottomOf="@id/dictionary_nameBR"
		app:layout_constraintLeft_toLeftOf="parent"
		app:layout_constraintRight_toLeftOf="@id/dictionary_sortRG"
		android:hint="@string/a_dictionary_description"
		android:autofillHints="description"
		android:inputType="textMultiLine"
		android:maxLines="5"/>
	
	<RadioGroup
		android:id="@+id/dictionary_sortRG"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		app:layout_constraintTop_toTopOf="@id/dictionary_colorIB"
		app:layout_constraintRight_toRightOf="parent"
		android:orientation="vertical">
		
		<RadioButton
			android:id="@+id/dictionary_sortLang1RB"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			tool:text="CD↓"/>
		
		<RadioButton
			android:id="@+id/dictionary_sortLang2RB"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			tool:text="CD↓"/>
		
	</RadioGroup>
	
	<androidx.constraintlayout.widget.Barrier
		android:id="@+id/dictionary_descriptionBR"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		app:barrierDirection="bottom"
		app:constraint_referenced_ids="dictionary_descriptionET,dictionary_sortRG"/>
	
	<Button
		android:id="@+id/dictionary_cancelBT"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		app:layout_constraintTop_toBottomOf="@id/dictionary_descriptionBR"
		app:layout_constraintLeft_toLeftOf="parent"
		app:layout_constraintRight_toLeftOf="@id/dictionary_saveBT"
		app:layout_constraintBottom_toTopOf="@id/dictionary_headBR"
		android:layout_margin="5dp"
		tool:text="Cancel/Delete"/>
	
	<Button
		android:id="@+id/dictionary_saveBT"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		app:layout_constraintTop_toBottomOf="@id/dictionary_descriptionBR"
		app:layout_constraintLeft_toRightOf="@id/dictionary_cancelBT"
		app:layout_constraintRight_toLeftOf="@id/dictionary_infoIB"
		app:layout_constraintBottom_toTopOf="@id/dictionary_headBR"
		android:layout_margin="5dp"
		android:text="@string/save"/>
	
	<ImageButton
		android:id="@+id/dictionary_infoIB"
		android:layout_width="50dp"
		android:layout_height="50dp"
		app:layout_constraintTop_toBottomOf="@id/dictionary_descriptionBR"
		app:layout_constraintLeft_toRightOf="@id/dictionary_saveBT"
		app:layout_constraintRight_toRightOf="parent"
		app:layout_constraintBottom_toTopOf="@id/dictionary_headBR"
		android:scaleType="fitCenter"
		android:src="@drawable/ic_launcher_foreground"
		android:contentDescription="@string/help"/>
	
	<androidx.constraintlayout.widget.Barrier
		android:id="@+id/dictionary_headBR"
		android:layout_width="0dp"
		android:layout_height="0dp"
		app:barrierDirection="bottom"
		app:constraint_referenced_ids="dictionary_cancelBT,dictionary_saveBT,dictionary_sortRG"/>
	
	<ProgressBar
		android:id="@+id/dictionary_loadPB"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:layout_constraintTop_toBottomOf="@id/dictionary_headBR"
		app:layout_constraintLeft_toLeftOf="parent"
		app:layout_constraintRight_toRightOf="parent"
		style="@style/Widget.AppCompat.ProgressBar.Horizontal"
		android:indeterminate="true"
		android:visibility="invisible"/>
	
	<ListView
		android:id="@+id/dictionary_list1LV"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		app:layout_constraintTop_toBottomOf="@id/dictionary_loadPB"
		app:layout_constraintLeft_toLeftOf="parent"
		app:layout_constraintRight_toRightOf="parent"
		app:layout_constraintBottom_toBottomOf="parent"/>
	
	<ListView
		android:id="@+id/dictionary_list2LV"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		app:layout_constraintTop_toBottomOf="@id/dictionary_loadPB"
		app:layout_constraintLeft_toLeftOf="parent"
		app:layout_constraintRight_toRightOf="parent"
		app:layout_constraintBottom_toBottomOf="parent"
		android:visibility="gone"/>
	
</androidx.constraintlayout.widget.ConstraintLayout>