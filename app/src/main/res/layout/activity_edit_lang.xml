<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	xmlns:app="http://schemas.android.com/apk/res-auto">
	
	<ProgressBar
		android:id="@+id/editLang_loadPB"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintLeft_toLeftOf="parent"
		app:layout_constraintRight_toRightOf="parent"
		style="@style/Widget.AppCompat.ProgressBar.Horizontal"
		android:indeterminate="true"
		android:visibility="invisible"/>
	
	<Button
		android:id="@+id/editLang_addBT"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		app:layout_constraintTop_toBottomOf="@id/editLang_loadPB"
		app:layout_constraintLeft_toLeftOf="parent"
		app:layout_constraintRight_toLeftOf="@id/editLang_infoIB"
		app:layout_constraintBottom_toTopOf="@id/editLang_headBR"
		android:text="@string/a_editLang_addLang"/>
	
	<ImageButton
		android:id="@+id/editLang_infoIB"
		android:layout_width="50dp"
		android:layout_height="50dp"
		app:layout_constraintTop_toBottomOf="@id/editLang_loadPB"
		app:layout_constraintLeft_toRightOf="@id/editLang_addBT"
		app:layout_constraintRight_toRightOf="parent"
		app:layout_constraintBottom_toTopOf="@id/editLang_headBR"
		app:layout_constraintDimensionRatio="W,1:1"
		android:scaleType="fitCenter"
		android:src="@drawable/ic_launcher_foreground"
		android:contentDescription="@string/help"/>
	
	<androidx.constraintlayout.widget.Barrier
		android:id="@+id/editLang_headBR"
		android:layout_width="0dp"
		android:layout_height="0dp"
		app:barrierDirection="bottom"
		app:constraint_referenced_ids="editLang_addBT,editLang_infoIB"/>
	
	<ListView
		android:id="@+id/editLang_listLV"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:layout_constraintTop_toBottomOf="@id/editLang_headBR"
		app:layout_constraintLeft_toLeftOf="parent"
		app:layout_constraintRight_toRightOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>