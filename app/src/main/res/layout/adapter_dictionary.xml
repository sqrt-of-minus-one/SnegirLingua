<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tool="http://schemas.android.com/tools">
	
	<View
		android:id="@+id/a_dictionary_colorVW"
		android:layout_width="15dp"
		android:layout_height="match_parent"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintLeft_toLeftOf="parent"
		app:layout_constraintBottom_toBottomOf="parent"/>
	
	<TextView
		android:id="@+id/a_dictionary_nameTV"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintLeft_toRightOf="@id/a_dictionary_colorVW"
		app:layout_constraintRight_toLeftOf="@id/a_dictionary_deleteIB"
		app:layout_constraintBottom_toTopOf="@id/a_dictionary_wordsTV"
		android:layout_marginStart="5dp"
		tool:text="Dictionary"
		style="@style/TextAppearance.AppCompat.Headline"/>
	
	<TextView
		android:id="@+id/a_dictionary_wordsTV"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		app:layout_constraintTop_toBottomOf="@id/a_dictionary_nameTV"
		app:layout_constraintLeft_toRightOf="@id/a_dictionary_colorVW"
		app:layout_constraintRight_toLeftOf="@id/a_dictionary_deleteIB"
		app:layout_constraintBottom_toBottomOf="parent"
		android:layout_marginStart="25dp"
		tool:text="Words: N"/>
	
	<ImageButton
		android:id="@+id/a_dictionary_deleteIB"
		android:layout_width="50dp"
		android:layout_height="50dp"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintRight_toRightOf="parent"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintDimensionRatio="W,1:1"
		android:layout_margin="8dp"
		android:src="@drawable/ic_launcher_foreground"
		android:scaleType="fitCenter"
		android:contentDescription="@string/delete"/>
	
</androidx.constraintlayout.widget.ConstraintLayout>