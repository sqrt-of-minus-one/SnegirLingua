<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tool="http://schemas.android.com/tools">
	
	<RadioGroup
		android:id="@+id/words_sortRG"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintLeft_toLeftOf="parent"
		app:layout_constraintRight_toLeftOf="@id/words_infoIB"
		app:layout_constraintBottom_toTopOf="@id/words_headBR"
		android:orientation="horizontal">
		
		<RadioButton
			android:id="@+id/words_sortLang1RB"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			tool:text="CD↓"/>
		
		<RadioButton
			android:id="@+id/words_sortLang2RB"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			tool:text="CD↓"/>
		
	</RadioGroup>
	
	<ImageButton
		android:id="@+id/words_infoIB"
		android:layout_width="50dp"
		android:layout_height="50dp"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintRight_toRightOf="parent"
		app:layout_constraintBottom_toTopOf="@id/words_headBR"
		app:layout_constraintDimensionRatio="W,1:1"
		android:scaleType="fitCenter"
		android:src="@drawable/ic_launcher_foreground"
		android:contentDescription="@string/help"/>
	
	<androidx.constraintlayout.widget.Barrier
		android:id="@+id/words_headBR"
		android:layout_width="0dp"
		android:layout_height="0dp"
		app:barrierDirection="bottom"
		app:constraint_referenced_ids="words_sortRG,words_infoIB"/>
	
	<ProgressBar
		android:id="@+id/words_loadPB"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:layout_constraintTop_toBottomOf="@id/words_headBR"
		app:layout_constraintLeft_toLeftOf="parent"
		app:layout_constraintRight_toRightOf="parent"
		style="@style/Widget.AppCompat.ProgressBar.Horizontal"
		android:indeterminate="true"
		android:visibility="invisible"/>
	
	<Button
		android:id="@+id/words_addBT"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:layout_constraintTop_toBottomOf="@id/words_loadPB"
		app:layout_constraintLeft_toLeftOf="parent"
		app:layout_constraintRight_toRightOf="parent"
		android:text="@string/a_words_addWord"/>
	
	<ListView
		android:id="@+id/words_list1LV"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		app:layout_constraintTop_toBottomOf="@id/words_addBT"
		app:layout_constraintLeft_toLeftOf="parent"
		app:layout_constraintRight_toRightOf="parent"
		app:layout_constraintBottom_toBottomOf="parent"/>
	
	<ListView
		android:id="@+id/words_list2LV"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		app:layout_constraintTop_toBottomOf="@id/words_addBT"
		app:layout_constraintLeft_toLeftOf="parent"
		app:layout_constraintRight_toRightOf="parent"
		app:layout_constraintBottom_toBottomOf="parent"
		android:visibility="gone"/>
	
</androidx.constraintlayout.widget.ConstraintLayout>